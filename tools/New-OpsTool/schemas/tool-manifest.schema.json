{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerShell Ops Toolkit Tool Manifest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*-[A-Za-z][A-Za-z0-9-]*$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "folders": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "required": ["name"]
}
